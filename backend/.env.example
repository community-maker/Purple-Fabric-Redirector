# =============================================================================
# Purple Fabric Agent Directory API - Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- CORS ---
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Purple Fabric / Magic Platform ---
PURPLE_FABRIC_ENDPOINT=https://api.in.intellectseecstag.com
PURPLE_FABRIC_WEB_BASE_URL=https://in.intellectseecstag.com
PURPLE_FABRIC_TENANT=idx
PURPLE_FABRIC_API_KEY=magicplatform.replace-with-real-api-key
PURPLE_FABRIC_USERNAME=service.user@example.com
PURPLE_FABRIC_PASSWORD=replace-with-real-password
PURPLE_FABRIC_WORKSPACE_ID=replace-with-workspace-id
PURPLE_FABRIC_API_VERSION=v1
PURPLE_FABRIC_TOKEN_REFRESH_BUFFER_MS=30000
PURPLE_FABRIC_TIMEOUT_MS=30000
